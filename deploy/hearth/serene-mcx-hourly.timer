[Unit]
Description=serene MCX hourly pulse, after each hour of the 09:00-23:55 IST session

[Timer]
# 10:00 reports 09:00-10:00, ... 23:00 reports 22:00-23:00. The 45 s lets
# Kite finish the hour's last minute candle.
OnCalendar=Mon..Fri *-*-* 10..23:00:45 Asia/Kolkata
# The session closes at 23:55 (23:30 in the US summer): report the last hour.
OnCalendar=Mon..Fri *-*-* 23:56:00 Asia/Kolkata
# No catch-up after downtime: an old hour is no use.
Persistent=false

[Install]
WantedBy=timers.target
