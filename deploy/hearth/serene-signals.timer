[Unit]
Description=serene forward-test signals, each minute of the 09:00-23:55 IST MCX session

[Timer]
# 20 s past each minute, so Kite has finished the minute that just closed. A
# 15m cross is posted at most about a minute after its bar closes.
OnCalendar=Mon..Fri *-*-* 09..23:*:20 Asia/Kolkata
AccuracySec=1s
# No catch-up after downtime: the next run posts anything missed.
Persistent=false

[Install]
WantedBy=timers.target
