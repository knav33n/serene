[Unit]
Description=serene weekly FIPA and CEPA lists, Friday after the NSE close

[Timer]
# Kite's daily candle is final well before 16:30, and that day's Kite and
# Upstox logins still work. On a Friday holiday the lists use Thursday's close.
OnCalendar=Fri *-*-* 16:30:00 Asia/Kolkata
# Catch up after downtime the same evening, while the tokens still work.
Persistent=true

[Install]
WantedBy=timers.target
