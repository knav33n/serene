[Unit]
Description=serene goldm/silverm_hmasma_10m: signals to Slack, then live Zerodha orders
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=serene
Group=serene
WorkingDirectory=/home/serene/app
# goldm/silverm_ema_15m stopped 2026-11-24, goldm/silverm_hma_1h stopped later that day.
# goldm/silverm_hmasma_10m trade LIVE on Zerodha from 2026-11-24, 1 lot each, from their next cross.
# The signal step may fail without stopping the live step, which reads the bars it fetched.
ExecStart=-/home/serene/app/serene forward signals --fetch --slack --strategies goldm_hmasma_10m,silverm_hmasma_10m
ExecStart=/home/serene/app/serene live mcx --slack --channel C0CH2BZU202
TimeoutStartSec=10min
