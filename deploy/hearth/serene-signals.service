[Unit]
Description=serene forward-test signals (goldm_hma_1h, silverm_hma_1h) to Slack
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=serene
Group=serene
WorkingDirectory=/home/serene/app
# goldm/silverm_ema_15m stopped 2026-11-24. Live MCX orders were switched off on 2026-11-20 and their code removed on 2026-11-23; the signals still post.
ExecStart=/home/serene/app/serene forward signals --fetch --slack --strategies goldm_hma_1h,silverm_hma_1h
TimeoutStartSec=10min
