[Unit]
Description=serene forward-test signals (goldm_ema_15m, goldm_hma_1h, silverm_ema_15m, silverm_hma_1h) to Slack
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=serene
Group=serene
WorkingDirectory=/home/serene/app
# Live MCX orders were switched off on 2026-11-20 and their code removed on 2026-11-23; the signals still post.
ExecStart=/home/serene/app/serene forward signals --fetch --slack --strategies goldm_ema_15m,goldm_hma_1h,silverm_ema_15m,silverm_hma_1h
TimeoutStartSec=10min
