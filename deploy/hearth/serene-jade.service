[Unit]
Description=serene jade_lizard: NIFTY Jade Lizard, one lot live on Zerodha
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=serene
Group=serene
WorkingDirectory=/home/serene/app
ExecStart=/home/serene/app/serene live jade --slack
TimeoutStartSec=12min
