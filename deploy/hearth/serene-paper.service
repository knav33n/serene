[Unit]
Description=serene nifty_hma_crossover: 10m HMA 13/34 crosses of the ATM NIFTY CE/PE, to Slack with buy/sell buttons (no orders of its own)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=serene
Group=serene
WorkingDirectory=/home/serene/app
ExecStart=/home/serene/app/serene paper hmacross --slack
TimeoutStartSec=5min
