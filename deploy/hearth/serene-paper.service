[Unit]
Description=serene hma_crossover: 10m HMA 13/34 up-crosses of the ATM and ±100 NIFTY and SENSEX CE/PE, to Slack with buy buttons; buys the first 2 near-HMA pullbacks of each index a day on Fyers (all free cash) and Zerodha (₹1L), one per contract, none in a contract already held, sold at a 2% target
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=serene
Group=serene
WorkingDirectory=/home/serene/app
ExecStart=/home/serene/app/serene paper hmacross --slack --fyers --zerodha
TimeoutStartSec=5min
