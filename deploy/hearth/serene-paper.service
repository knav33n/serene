[Unit]
Description=serene paper trade nifty_hma_retest to Slack
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=serene
Group=serene
WorkingDirectory=/home/serene/app
ExecStart=/home/serene/app/serene paper hmaretest --slack
TimeoutStartSec=5min
