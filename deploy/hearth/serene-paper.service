[Unit]
Description=serene paper trade nifty_ema_retest to Slack
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=serene
Group=serene
WorkingDirectory=/home/serene/app
ExecStart=/home/serene/app/serene paper emaretest --slack
TimeoutStartSec=5min
