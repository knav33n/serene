[Unit]
Description=serene nifty_hma_crossover: 10m HMA 13/34 crosses of the ATM NIFTY CE/PE, to Slack with buy/sell buttons; squares off the buttons' buys on a down-cross
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=serene
Group=serene
WorkingDirectory=/home/serene/app
ExecStart=/home/serene/app/serene paper hmacross --slack --exit --fyers
TimeoutStartSec=5min
