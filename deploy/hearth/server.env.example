# hearth's .env: cp deploy/hearth/server.env.example deploy/hearth/server.env (git-ignored), fill
# it in, then deploy/hearth/env.sh uploads it to the SSM SecureString /serene/env.
# Both databases are on hearth's own Postgres; the serene user logs in over the socket (peer auth).
SERENE_DATABASE_URL=postgres://serene@/serene?host=/var/run/postgresql
# project_calm's database: serene auth put writes each morning's Kite and Upstox logins into it.
CALM_DATABASE_URL=postgres://serene@/project_calm?host=/var/run/postgresql
# A fresh key for hearth's own token store: openssl rand -base64 32
SERENE_TOKEN_KEY=
ZERODHA_API_KEY=
# The manual trades page's brokers beyond Zerodha and Upstox (their logins come with serene auth push)
FYERS_APP_ID=
BREEZE_API_KEY=
BREEZE_API_SECRET=
# The manual trades page's login at https://hearth.naveenkumar.dev/: both from serene manual setup
SERENE_MANUAL_PASSWORD=
SERENE_MANUAL_TOTP=
SLACK_TOKEN=
SLACK_CHANNEL=
SLACK_TRADES_CHANNEL=C0CH2BZU202
SLACK_SILVERM_CHANNEL=C0CH2BZU202
SLACK_PAPER_CHANNEL=C0CGWU1QK7X
SLACK_PDL_CHANNEL=C0CH4E87RNW
SLACK_JADE_CHANNEL=C0CKUG059A9
SLACK_SCANS_CHANNEL=C0CJDBSAHKR
# Failure and recovery alerts from every job; without it they go to the job's own channel.
SLACK_ALERT_CHANNEL=C0CGXMPGRL7
# Buttons on goldm/silverm_hma_1h signals that place 1 lot of the current or next future on Zerodha.
# The Slack app's Interactivity Request URL must be https://hearth.naveenkumar.dev/slack/actions.
# Both must be set, or the signals post without buttons and Hearth takes no clicks.
SLACK_SIGNING_SECRET=
SLACK_ORDER_USERS=
