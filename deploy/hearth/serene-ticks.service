[Unit]
Description=serene tick recorder: Kite full-mode ticks of the nearest-expiry ATM and ±100 NIFTY and SENSEX CE/PE (strikes from the 09:15 open) plus the NIFTY 50 index and nearest NIFTY future, 09:14–15:31 IST on trading days, into data/ticks (nothing to Slack)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=serene
Group=serene
WorkingDirectory=/home/serene/app
ExecStart=/home/serene/app/serene paper ticks
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
