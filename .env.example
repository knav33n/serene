# Copy to .env and fill in. .env is ignored by git.
SERENE_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Optional: project_calm's database. serene auth writes each login (Kite,
# Upstox, Breeze) into its trading.broker_sessions, which calm reads.
CALM_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/project_calm
# Generate with: openssl rand -base64 32
SERENE_TOKEN_KEY=
# A broker with no keys shows as "not configured".
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Must exactly match the redirect URI registered on your Upstox app.
# With httpbin, copy the code from the page it shows into serene auth.
# If unset, the default is http://127.0.0.1:8080/callback/upstox
UPSTOX_REDIRECT_URI=https://httpbin.org/get
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# ICICI Breeze, for project_calm's MCX history. Its login is pasted: copy the
# apisession from the page it redirects to.
BREEZE_API_KEY=
BREEZE_API_SECRET=
# Fyers API v3 app (myapi.fyers.in/dashboard). The app ID looks like ABCD1234-100.
FYERS_APP_ID=
FYERS_SECRET=
# Must exactly match the redirect URL registered on the Fyers app.
# If unset, the default is http://127.0.0.1:8080/callback/fyers
FYERS_REDIRECT_URI=
# For serene market daily --slack. The bot token (xoxb-) needs chat:write and
# files:write, plus im:write for direct messages. Invite the bot to a private channel.
SLACK_TOKEN=
# A channel ID (C...), or your member ID (U...) for a direct message.
SLACK_CHANNEL=
